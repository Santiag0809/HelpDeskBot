    {
      "parameters": {
        "chatId": "={{ $('Extraer datos del mensaje').item.json.chatId }}",
        "text": "⛔ <b>Acceso denegado</b>\n\nTu usuario no está registrado o no tiene acceso.\n\nContacta al administrador.",
        "additionalFields": { "parse_mode": "HTML" }
      },
      "id": "msg-no-access",
      "name": "Mensaje: sin acceso",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [980, 480],
      "credentials": { "telegramApi": { "id": "IBs15lGMFpZJlRkO", "name": "Telegram account" } }
    },
    {
      "parameters": {
        "jsCode": "// Verificar si hay wizard activo\nconst data = $('Extraer datos del mensaje').item.json;\nconst sd = $getWorkflowStaticData('global');\nconst wizard = sd[data.wizardKey] || null;\nconst enWizard = wizard !== null;\nreturn [{ json: { ...data, enWizard, wizard } }];"
      },
      "id": "check-wizard",
      "name": "¿Hay wizard activo?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 280]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.enWizard }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-wizard",
      "name": "¿En wizard?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1180, 280]
    },
    {
      "parameters": {
        "jsCode": "// Procesar paso del wizard\nconst { chatId, text, wizardKey, username } = $json;\nconst sd = $getWorkflowStaticData('global');\nconst estado = sd[wizardKey] || { paso: 0 };\n\nif (text === '9') {\n  delete sd[wizardKey];\n  return [{ json: { chatId, action: 'cancelar' } }];\n}\n\nif (estado.paso === 0) {\n  const tipos = { '1': 'Soporte técnico', '2': 'Solicitud administrativa', '3': 'Consulta general' };\n  if (!tipos[text]) return [{ json: { chatId, action: 'error_tipo' } }];\n  sd[wizardKey] = { paso: 1, tipo: tipos[text], username };\n  return [{ json: { chatId, action: 'pedir_prioridad', tipo: tipos[text] } }];\n}\n\nif (estado.paso === 1) {\n  const prioridades = { '1': 'Alta', '2': 'Media', '3': 'Baja' };\n  if (!prioridades[text]) return [{ json: { chatId, action: 'error_prioridad' } }];\n  sd[wizardKey] = { ...estado, paso: 2, prioridad: prioridades[text] };\n  return [{ json: { chatId, action: 'pedir_descripcion', prioridad: prioridades[text] } }];\n}\n\nif (estado.paso === 2) {\n  if (text.length < 10) return [{ json: { chatId, action: 'error_descripcion' } }];\n  sd[wizardKey] = { ...estado, paso: 3, descripcion: text };\n  return [{ json: { chatId, action: 'pedir_confirmacion', estado: sd[wizardKey] } }];\n}\n\nif (estado.paso === 3) {\n  if (text === '2') { delete sd[wizardKey]; return [{ json: { chatId, action: 'cancelar' } }]; }\n  if (text !== '1') return [{ json: { chatId, action: 'error_confirmacion', estado } }];\n  const idTicket = 'TKT-' + String(Date.now()).slice(-5);\n  const fecha = new Date().toISOString().replace('T',' ').slice(0,16);\n  delete sd[wizardKey];\n  return [{ json: { chatId, action: 'guardar', ticket: { id_ticket: idTicket, tipo: estado.tipo, prioridad: estado.prioridad, descripcion: estado.descripcion, estado: 'Abierto', creado_por: estado.username, fecha_creacion: fecha } } }];\n}\n\nreturn [{ json: { chatId, action: 'cancelar' } }];"
      },
      "id": "proc-wizard",
      "name": "Procesar wizard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1380, 180]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "pedir_prioridad", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "pedir_prioridad" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "pedir_descripcion", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "pedir_descripcion" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "pedir_confirmacion", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "pedir_confirmacion" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "guardar", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "guardar" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "cancelar", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "cancelar" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "router-wizard",
      "name": "Router wizard",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
