        "telegramApi": {
          "id": "IBs15lGMFpZJlRkO",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nconst chatId = msg?.message?.chat?.id || msg?.callback_query?.message?.chat?.id;\nconst userId = msg?.message?.from?.id || msg?.callback_query?.from?.id;\nconst username = msg?.message?.from?.username || msg?.callback_query?.from?.username || 'desconocido';\nconst text = (msg?.message?.text || '').trim();\nif (!chatId) throw new Error('No se pudo extraer chat_id');\n\n// Revisar si hay un wizard activo para este usuario\nconst sd = $getWorkflowStaticData('global');\nconst key = `wizard_${chatId}`;\nconst wizard = sd[key] || null;\n\nreturn [{ json: { chatId, userId, username, text, wizard, wizardKey: key } }];"
      },
      "id": "extract-data",
      "name": "Extraer datos del mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "documentId": { "__rl": true, "value": "155DnfVRJTx4uBvuLjlFba2a4NeYZtAGhOqSeR8GK-Tc", "mode": "id" },
        "sheetName": { "__rl": true, "value": "USUARIOS", "mode": "name" },
        "filtersUI": {
          "values": [{ "lookupColumn": "telegram_user", "lookupValue": "={{ $json.username }}" }]
        },
