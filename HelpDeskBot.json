    {
      "parameters": {
        "chatId": "={{ $('Extraer datos del mensaje').item.json.chatId }}",
        "text": "Hola, soy HelpDeskBot 👋\n\nEstoy aquí para ayudarte con solicitudes de soporte de forma rápida y ordenada.\n\nPor favor escribe el <b>número</b> de la opción que quieras usar:\n\n<b>Menú principal:</b>\n0️⃣  Ayuda\n1️⃣  Crear solicitud\n2️⃣  Consultar estado de solicitud\n3️⃣  Mis solicitudes\n4️⃣  Reportes\n5️⃣  Configuración",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
