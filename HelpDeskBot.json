    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\n\nconst chatId = msg?.message?.chat?.id || msg?.callback_query?.message?.chat?.id;\nconst userId = msg?.message?.from?.id || msg?.callback_query?.from?.id;\nconst username = msg?.message?.from?.username || msg?.callback_query?.from?.username || 'desconocido';\nconst text = (msg?.message?.text || '').trim();\n\nif (!chatId) {\n  throw new Error('No se pudo extraer chat_id del mensaje');\n}\n\nreturn [{\n  json: {\n    chatId,\n    userId,\n    username,\n    text,\n    rawMessage: msg\n  }\n}];"
      },
