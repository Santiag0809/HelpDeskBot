            { "conditions": { "conditions": [{ "leftValue": "={{ $('Extraer datos del mensaje').item.json.text }}", "rightValue": "0", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "ayuda" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $('Extraer datos del mensaje').item.json.text }}", "rightValue": "1", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "crear_solicitud" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $('Extraer datos del mensaje').item.json.text }}", "rightValue": "2", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "renameOutput": true, "outputKey": "consultar_estado" },
